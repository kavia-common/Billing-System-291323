# Backend environment example for Billing System (do not commit your real .env)
# Provide these to the runtime environment. The orchestrator will set actual values.

# PUBLIC_INTERFACE
# PORT the Express server will listen on. Defaults to 3001 if not set.
PORT=3001

# PUBLIC_INTERFACE
# Supabase project URL, found in your Supabase project settings
SUPABASE_URL=

# PUBLIC_INTERFACE
# Supabase service role or anon key. Service role is recommended for server-side with RLS configured.
SUPABASE_KEY=
